/* Edit colours, spacing and typography here. Restart the app to apply. */
QWidget { background: #f4f5f8; color: #242536; font-family: "Segoe UI"; font-size: 13px; }
QLabel#title { font-size: 26px; font-weight: 700; }
QLabel#caption { color: #6b6c80; font-size: 11px; font-weight: 700; padding-bottom: 8px; }
QGroupBox { background: #ffffff; border: 1px solid #dedfe8; border-radius: 10px; margin-top: 14px; padding: 20px 12px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 5px; }
QGroupBox QLabel, QGroupBox QCheckBox { background: transparent; font-weight: 400; }
QPushButton { background: #ffffff; border: 1px solid #d9dae5; border-radius: 7px; padding: 9px 14px; font-weight: 600; }
QPushButton:hover { background: #edeaf9; border-color: #9d8dc8; }
QPushButton:pressed { background: #e1dbf3; }
QPushButton#primary { background: #7450b5; color: white; border-color: #7450b5; }
QPushButton#primary:hover { background: #63419f; }
QPushButton:disabled, QPushButton#primary:disabled { background: #e7e7ef; color: #9696a6; border-color: #e0e0e9; }
QSpinBox, QDoubleSpinBox { background: white; border: 1px solid #d9dae5; border-radius: 5px; padding: 6px; min-width: 85px; }
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #7450b5; }
QLabel#preview { background: #e9eaf0; border: 1px solid #dadce6; border-radius: 12px; color: #77798d; }
QScrollArea { border: none; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #9c9eaf; border-radius: 4px; background: white; }
QCheckBox::indicator:checked { background: #7450b5; border: 3px solid #c3b4df; }
QStatusBar { color: #6b6c80; padding: 6px 18px; }
QSplitter::handle { background: transparent; width: 5px; }
